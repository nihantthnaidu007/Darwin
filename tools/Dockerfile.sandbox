# The sandbox image for the container primitive (Phase I0).
#
# Minimal, pinned base for running ONE untrusted Python candidate inside a
# locked-down container (see sandbox_container.py for the lockdown flags applied
# at run time: no network, read-only root, memory/CPU/PID caps, non-root).
#
# In-container dependency set = Python stdlib + pytest, pinned. That is exactly
# what the cases need: every test_suite.py only does `from candidate import ...`
# and uses pytest; the candidate code itself imports stdlib only. The host-side
# tools (radon, vulture, anthropic) never run inside the container, so they are
# intentionally absent. LIMITATION: a candidate that imports a package outside
# this set (e.g. numpy) fails at import inside the container with
# ModuleNotFoundError, surfaced as status=failed. To support more, add pinned
# packages here and rebuild. For v2.0 the known case dependency set is enough.
#
# Build (one-time host setup; the Docker prerequisite must be met):
#   docker build -f tools/Dockerfile.sandbox -t darwin-sandbox:py313 tools/
#
# BASE IMAGE PIN (P6.1, decision 0027). The base is pinned by its multi-arch
# manifest-list digest, not the mutable python:3.13-slim tag, so a rebuild pulls
# the exact same base and the security boundary cannot change under us between
# builds. The digest below is the OCI image index (manifest list) digest, which
# resolves to the correct per-platform image on both arm64 and x86_64, so the
# same FROM line is reproducible across architectures.
#
# REPRODUCIBLE BY CONSTRUCTION: the pinned base plus this committed Dockerfile
# fully determine the sandbox image's security-relevant content. run() in
# sandbox_container.py resolves the local tag darwin-sandbox:py313, which is
# built from this file, so it resolves to an image built from this fixed base.
# The locally built sandbox image is NOT given a fixed committed digest: it has
# no portable digest (it is built per host and per architecture), so a hardcoded
# one would break on a fresh clone. The boundary is made reproducible by the
# pinned base digest plus this Dockerfile, and the digest lives in exactly one
# place (the FROM line below), so there is nothing to keep in sync.
#
# ROTATION (when the base ships a security update worth taking):
#   1. Fetch the current manifest-list digest:
#        docker buildx imagetools inspect python:3.13-slim --format '{{.Manifest.Digest}}'
#      (or: docker manifest inspect python:3.13-slim, and take the top-level
#      manifest-list digest, not a per-platform one).
#   2. Replace ONLY the digest on the FROM line below with the new value.
#   3. Rebuild the sandbox image from the pinned base:
#        docker build -f tools/Dockerfile.sandbox -t darwin-sandbox:py313 tools/
#   Nothing else changes; the digest is pinned in this one place.
FROM python:3.13-slim@sha256:c33f0bc4364a6881bed1ec0cc2665e6c53c87a43e774aaeab88e6f17af105e4f

# pytest is the only runtime dependency the in-container code needs.
RUN pip install --no-cache-dir pytest==8.3.5

# Run untrusted code as a non-root user. uid 1000 is also passed via --user at
# run time (defense in depth); HOME is overridden to the writable tmpfs at run
# time so a read-only root filesystem does not block Python/pytest.
RUN useradd --create-home --uid 1000 sandbox
USER sandbox
WORKDIR /sandbox
